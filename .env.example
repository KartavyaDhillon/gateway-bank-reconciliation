# Copy this file to ".env" and fill in what you need. ".env" is never pushed to GitHub.

# --- LLM (optional). Leave blank to run the analyst in offline extractive mode.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
# For Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   LLM_API_KEY=ollama
LLM_BASE_URL=

# --- Email (optional). Leave blank to only save the HTML summary.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
